PORT=8080
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# PostgreSQL connection string. For local development it points to the Docker container.
# For production on Neon, replace with the Neon connection URL (e.g., postgres://<user>:<pass>@<host>/<db>?sslmode=require)
DATABASE_URL=postgres://postgres:devpassword@localhost:5440/fbperformance?sslmode=disable

# Local Docker Redis (used when REDIS_URL is empty)
REDIS_ADDR=redis:6379

# Production Redis URL (Upstash). Use rediss://... and leave REDIS_ADDR unchanged.
# If REDIS_URL is set, the app will use it via redis.ParseURL().
REDIS_URL=

APIFY_API_TOKEN=
APIFY_ACTOR_ID=clockworks~tiktok-scraper

# Weekly auto re-sweep the API server runs on its own (see
# internal/services/trendingest.Scheduler) — optional, defaults shown below.
# Hour is UTC. Accepted weekday values: sunday..saturday.
TREND_INGEST_SCHEDULE_WEEKDAY=sunday
TREND_INGEST_SCHEDULE_HOUR=3

POSTHOG_API_KEY=
POSTHOG_HOST=
POSTHOG_DISTINCT_ID=fbperformance-backend
POSTHOG_FEATURE_FLAG_TIMEOUT_MS=200
